#!/usr/bin/env bash
# Drive synthform the way a user does. Run from the repo root.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
WORK="${SYNTHFORM_VERIFY_WORK:-/tmp/synthform-verify-work}"
EVIDENCE="${SYNTHFORM_VERIFY_EVIDENCE:-/tmp/synthform-verify-evidence}"
PY="${SYNTHFORM_PYTHON:-python3}"

cd "$ROOT"

doctor() {
  local version help
  version="$("$PY" -m synthform --version)"
  help="$("$PY" -m synthform fill --help)"
  printf '%s\n' "$version"
  printf '%s\n' "$help" | grep -q "Synthetic training sample"
  printf '%s\n' "$help" | grep -q "Not a signed original"
  printf '%s\n' "$help" | grep -q "Form 1583"
  printf 'doctor ok version=%s\n' "$version"
}

SCRIPTS="$ROOT/skills/verify-synthform/scripts"

prepare() {
  RUN="$WORK/$1"
  EV="$EVIDENCE/$1"
  rm -rf "$RUN" "$EV"
  mkdir -p "$RUN" "$EV"
}

run_fill() {
  local label="$1" hashseed="$2"
  shift 2
  local cmd=("$PY" -m synthform fill "$@")
  printf '%q ' env "PYTHONHASHSEED=$hashseed" "${cmd[@]}" > "$EV/command$label.txt"
  printf '\n' >> "$EV/command$label.txt"
  set +e
  env "PYTHONHASHSEED=$hashseed" "${cmd[@]}" > "$EV/stdout$label.txt" 2> "$EV/stderr$label.txt"
  RC=$?
  set -e
  printf '%s\n' "$RC" > "$EV/exit_code$label.txt"
}

need_exit() {
  if [[ "$RC" -ne "$1" ]]; then
    echo "fill exited $RC, expected $1" >&2
    exit "$(( RC == 0 ? 1 : RC ))"
  fi
}

drive_fill_boxes() {
  prepare fill-boxes
  "$PY" "$SCRIPTS/make-blank-form.py" "$RUN"
  run_fill "" random --form "$RUN/blank.pdf" --data "$RUN/rows.csv" --boxes "$RUN/boxes.json" \
    --out "$RUN/out" --dpi 100 --seed 7
  need_exit 0
  run_fill -twin random --form "$RUN/blank.pdf" --data "$RUN/rows-twin.csv" --boxes "$RUN/boxes.json" \
    --out "$RUN/out-twin" --dpi 100 --seed 7
  need_exit 0
  cp "$RUN/out/labels.jsonl" "$RUN/out/manifest.json" "$EV/"
  "$PY" "$SCRIPTS/check-fill-boxes.py" "$RUN/out" "$EV" "$RUN/out-twin"
  echo "drive-fill-boxes ok evidence=$EV"
}

drive_fill_acroform() {
  prepare fill-acroform
  "$PY" "$SCRIPTS/make-acroform.py" "$RUN"
  run_fill "" random --form "$RUN/acro.pdf" --data "$RUN/rows.csv" --boxes "$RUN/decoy-boxes.json" \
    --out "$RUN/out" --dpi 90 --seed 3
  need_exit 0
  cp "$RUN/out/labels.jsonl" "$RUN/out/manifest.json" "$EV/"
  "$PY" "$SCRIPTS/check-drive.py" acroform "$RUN/out" "$EV"
  echo "drive-fill-acroform ok evidence=$EV"
}

drive_fill_json_image() {
  prepare fill-json-image
  "$PY" "$SCRIPTS/make-png-form.py" "$RUN"
  run_fill "" random --form "$RUN/blank.png" --data "$RUN/rows.json" --boxes "$RUN/boxes.json" \
    --out "$RUN/out" --dpi 72 --seed 1
  need_exit 0
  cp "$RUN/out/labels.jsonl" "$RUN/out/manifest.json" "$EV/"
  "$PY" "$SCRIPTS/check-drive.py" json-image "$RUN/out" "$EV"
  echo "drive-fill-json-image ok evidence=$EV"
}

drive_seed_repro() {
  prepare seed-repro
  "$PY" "$SCRIPTS/make-blank-form.py" "$RUN"
  run_fill -a 1 --form "$RUN/blank.pdf" --data "$RUN/rows.csv" --boxes "$RUN/boxes.json" \
    --out "$RUN/out-a" --dpi 72 --seed 7
  need_exit 0
  run_fill -b 2 --form "$RUN/blank.pdf" --data "$RUN/rows.csv" --boxes "$RUN/boxes.json" \
    --out "$RUN/out-b" --dpi 72 --seed 7
  need_exit 0
  cp "$RUN/out-a/labels.jsonl" "$EV/labels-a.jsonl"
  cp "$RUN/out-b/labels.jsonl" "$EV/labels-b.jsonl"
  if ! cmp -s "$EV/labels-a.jsonl" "$EV/labels-b.jsonl"; then
    echo "labels differ between the two runs" >&2
    exit 1
  fi
  echo "drive-seed-repro ok evidence=$EV"
}

drive_refuse_missing_boxes() {
  prepare refuse-missing-boxes
  "$PY" "$SCRIPTS/make-blank-form.py" "$RUN"
  run_fill "" random --form "$RUN/blank.pdf" --data "$RUN/rows.csv" --out "$RUN/out"
  need_exit 2
  if ! grep -q "PDF has no AcroForm text fields; pass --boxes" "$EV/stderr.txt"; then
    echo "stderr does not name the missing boxes" >&2
    exit 1
  fi
  if [[ -e "$RUN/out" ]]; then
    echo "$RUN/out exists after a refused run" >&2
    exit 1
  fi
  echo "drive-refuse-missing-boxes ok evidence=$EV"
}

drive_all() {
  local drive
  for drive in drive-fill-boxes drive-fill-acroform drive-fill-json-image drive-seed-repro drive-refuse-missing-boxes; do
    bash "$SCRIPTS/verify-synthform" "$drive"
  done
  echo "drive-all ok"
}

cleanup() {
  rm -rf "$WORK"
  echo "removed $WORK"
  echo "evidence kept at $EVIDENCE"
}

case "${1:-}" in
  doctor) doctor ;;
  drive-fill-boxes) drive_fill_boxes ;;
  drive-fill-acroform) drive_fill_acroform ;;
  drive-fill-json-image) drive_fill_json_image ;;
  drive-seed-repro) drive_seed_repro ;;
  drive-refuse-missing-boxes) drive_refuse_missing_boxes ;;
  drive-all) drive_all ;;
  cleanup) cleanup ;;
  *)
    echo "usage: verify-synthform doctor|drive-fill-boxes|drive-fill-acroform|drive-fill-json-image|drive-seed-repro|drive-refuse-missing-boxes|drive-all|cleanup" >&2
    exit 2
    ;;
esac
